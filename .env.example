# Copy this file to .env. Keep .env private; do not commit or publish it.
DB_HOST=localhost
DB_NAME=ecom
DB_USERNAME=root
DB_PASSWORD=
APP_URL=http://localhost/cms
CCAVENUE_MERCHANT_ID=your-merchant-id

# SMTP credentials are deployment secrets. Use a dedicated application password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.org
SMTP_PASSWORD=replace-with-a-new-app-password
SMTP_ENCRYPTION=tls

# Delay between messages sent by the queue worker (300000 = 0.3 seconds).
MAIL_QUEUE_DELAY_US=300000

# Generate unique values before production. Keep existing values when migrating live data.
APP_ENCRYPTION_KEY=replace-with-a-32-byte-secret
APP_ENCRYPTION_IV=replace-with-a-16-byte-secret
